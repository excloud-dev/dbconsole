[Unit]
Description=DBConsole - Database Console Application
Documentation=https://github.com/excloud/dbconsole
After=network.target

[Service]
Type=simple
User=dbconsole
Group=dbconsole
WorkingDirectory=/opt/dbconsole

# Load nvm and use node
Environment=NVM_DIR=/home/dbconsole/.nvm
ExecStart=/bin/bash -c 'source $NVM_DIR/nvm.sh && npm run start'

# Environment - load from .env file
EnvironmentFile=/opt/dbconsole/.env

# Restart policy
Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dbconsole

[Install]
WantedBy=multi-user.target
